<Application
    x:Class="MonzoManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#D9AE5E</Color>
                    <Color x:Key="SystemAccentColorLight1">#E3BA70</Color>
                    <Color x:Key="SystemAccentColorLight2">#F1CC86</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFE0A7</Color>
                    <Color x:Key="SystemAccentColorDark1">#B48845</Color>
                    <Color x:Key="SystemAccentColorDark2">#886531</Color>
                    <Color x:Key="SystemAccentColorDark3">#5D4627</Color>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource SystemAccentColorLight3}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource SystemAccentColorLight1}" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#2B1E0C" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#2B1E0C" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#2B1E0C" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{StaticResource SystemAccentColorLight2}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
